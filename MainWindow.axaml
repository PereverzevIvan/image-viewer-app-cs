<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageViewerApp.ViewModels"
        xmlns:conv="using:ImageViewerApp.Converters"
        xmlns:models="using:ImageViewerApp.Models"
        x:Class="ImageViewerApp.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Image Viewer"
        Background="#F0F0F0"
        WindowState="Maximized"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#007AFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0056B3"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#003D80"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="#007AFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0056B3"/>
        </Style>
        <Style Selector="ToggleButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#003D80"/>
        </Style>
        <Style Selector="Border.image-container">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="ZIndex" Value="0"/>
        </Style>
        <Style Selector="Border.image-container:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
            <Setter Property="ZIndex" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" 
                Background="White" 
                BoxShadow="0 2 4 0 #20000000"
                Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Open Folder"
                        Click="OnOpenFolderClick"/>
                <ToggleButton Content="{Binding IsHorizontalOrientation, 
                              Converter={x:Static conv:OrientationTextConverter.Instance}}"
                             IsChecked="{Binding IsHorizontalOrientation}"/>
                
                <TextBox Text="{Binding SearchQuery}"
                         Width="200"
                         Watermark="Search by name..."
                         Margin="10,0"/>
                
                <ComboBox SelectedItem="{Binding SelectedFileType}"
                         Width="100"
                         Margin="0,0,10,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <x:String>All</x:String>
                    <x:String>.jpg</x:String>
                    <x:String>.jpeg</x:String>
                    <x:String>.png</x:String>
                    <x:String>.gif</x:String>
                    <x:String>.bmp</x:String>
                </ComboBox>
                
                <ComboBox SelectedItem="{Binding SortType}"
                         Width="120">
                    <models:SortType>Name</models:SortType>
                    <models:SortType>DateCreated</models:SortType>
                    <models:SortType>Size</models:SortType>
                </ComboBox>
                
                <Button Command="{Binding ToggleSortDirectionCommand}"
                        Content="{Binding SortDescending, 
                                 Converter={x:Static conv:SortDirectionConverter.Instance}}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" 
                     Margin="10"
                     HorizontalScrollBarVisibility="{Binding IsHorizontalOrientation, 
                         Converter={x:Static conv:OrientationToScrollBarConverter.Instance}}"
                     VerticalScrollBarVisibility="{Binding !IsHorizontalOrientation, 
                         Converter={x:Static conv:OrientationToScrollBarConverter.Instance}}">
            <ItemsControl ItemsSource="{Binding Images}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="{Binding IsHorizontalOrientation, 
                                             Converter={x:Static conv:WrapOrientationConverter.Instance}}"
                                 Width="{Binding !IsHorizontalOrientation, 
                                         Converter={x:Static conv:ColumnsToWidthConverter.Instance},
                                         ConverterParameter={Binding}}"
                                 Height="{Binding IsHorizontalOrientation,
                                         Converter={x:Static conv:RowsToHeightConverter.Instance},
                                         ConverterParameter={Binding}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ImageFile}">
                        <Border Margin="10"
                                Classes="image-container"
                                Background="#20000000"
                                CornerRadius="10"
                                Width="200"
                                Height="200"
                                DoubleTapped="OnImageDoubleTapped">
                            <Panel>
                                <Image Source="{Binding Image}"
                                       Stretch="UniformToFill"/>
                                <Border Height="80"
                                        VerticalAlignment="Bottom"
                                        Background="#80000000">
                                    <StackPanel Margin="10,5">
                                        <TextBlock Text="{Binding Name}"
                                                  TextWrapping="NoWrap"
                                                  TextTrimming="CharacterEllipsis"
                                                  VerticalAlignment="Center"
                                                  Foreground="White"/>
                                        <TextBlock Text="{Binding CreationTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                  FontSize="12"
                                                  Foreground="#CCCCCC"
                                                  Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Size, 
                                                         Converter={x:Static conv:FileSizeConverter.Instance}}"
                                                  FontSize="12"
                                                  Foreground="#CCCCCC"/>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
